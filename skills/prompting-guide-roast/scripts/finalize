#!/usr/bin/env bash
# finalize — verify quotes, score, rank and render the roast report from the workflow's result.
# Usage: bash finalize --help. Exit codes: 0 ok, 2 bad input, 4 node unavailable.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
command -v node >/dev/null 2>&1 || {
  echo "NODE_UNAVAILABLE: node 22 or later is required to render the report. Install node and rerun; the workflow result file is unchanged."
  exit 4
}
exec node "$here/finalize.mjs" "$@"
